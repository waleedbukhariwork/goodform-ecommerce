# Copy separately for staging and production. Keep actual files outside Git.
APP_ENV=staging
POSTGRES_DB=goodform_staging
POSTGRES_USER=goodform_staging
DB_PASSWORD_FILE=/absolute/path/to/staging/db-password
DATABASE_URL_FILE=/absolute/path/to/staging/database-url
SESSION_KEY_FILE=/absolute/path/to/staging/session-key
MEDIA_NAMESPACE=staging-catalog
SITE_DOMAIN=staging.example.invalid
API_IMAGE=registry.example.invalid/goodform-api@sha256:REPLACE_WITH_DIGEST
WEB_IMAGE=registry.example.invalid/goodform-web@sha256:REPLACE_WITH_DIGEST
RELEASE_SHA=0000000
OBSERVE_ENABLED=false
