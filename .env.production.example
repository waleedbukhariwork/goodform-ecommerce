APP_ENV=production
NODE_ENV=production
DATABASE_URL_FILE=/run/secrets/database_url
SESSION_KEY_FILE=/run/secrets/session_key
MEDIA_NAMESPACE=production-catalog
PORT=4000
INTERNAL_API_ORIGIN=http://api:4000
OBSERVE_ENABLED=false
PUBLIC_ORIGIN=https://example.invalid
STRIPE_SECRET_KEY_FILE=/absolute/path/to/stripe-test-key
STRIPE_WEBHOOK_SECRET_FILE=/absolute/path/to/stripe-test-webhook-secret

# Google Virtual Try-On is disabled until access, funding and approval are verified.
INFERENCE_ENABLED=false
# INFERENCE_GOOGLE_PROJECT=example-project
# INFERENCE_GOOGLE_REGION=us-central1
# INFERENCE_MODEL_ID=virtual-try-on-001
# INFERENCE_GOOGLE_CREDENTIALS_FILE=/run/secrets/google-credentials
# INFERENCE_COST_CEILING_CENTS=6
# INFERENCE_DAILY_CAP=6

# Transactional mail. Production only: dev and staging never send.
MAIL_ENABLED=false

# Set MAIL_ENABLED=true to enforce email verification and password reset.
# Requires a verified Resend domain and a matching MAIL_FROM.
# MAIL_ENABLED=true
# RESEND_API_KEY_FILE=/run/secrets/resend-api-key
# MAIL_FROM=Goodform <hello@your-verified-domain>
